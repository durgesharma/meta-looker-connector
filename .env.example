# ==============================================================================
# Meta Ads API Credentials
# ==============================================================================
# App ID and App Secret from developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Long-lived System User or Admin Access Token with `ads_read` permission
META_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Meta Ad Account ID (with or without 'act_' prefix, e.g. act_1234567890 or 1234567890)
META_AD_ACCOUNT_ID=act_1234567890

# ==============================================================================
# Google Sheets Credentials
# ==============================================================================
# The full JSON string of your Google Cloud Service Account key file.
# Note: In local .env, wrap in single quotes or keep on one line.
GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "-----BEGIN RSA PRIVATE KEY-----\\n...\\n-----END RSA PRIVATE KEY-----\\n", "client_email": "service-account@your-project.iam.gserviceaccount.com", "client_id": "...", "auth_uri": "https://accounts.google.com/o/oauth2/auth", "token_uri": "https://oauth2.googleapis.com/token", "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs", "client_x509_cert_url": "..."}'

# Target Spreadsheet: Provide SPREADSHEET_ID (recommended) or SPREADSHEET_NAME
# (Spreadsheet ID is the long string in the sheet's URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_1234567890
# SPREADSHEET_NAME=Meta_Ads_Looker_Reporting

# Optional: Target tab name (default: Sheet1)
WORKSHEET_NAME=Sheet1

# ==============================================================================
# Optional Configurations
# ==============================================================================
# Set to 'true' if you want to bypass duplicate row checks on re-runs (default: false)
ALLOW_DUPLICATES=false

# Optional: Backfill a specific date (YYYY-MM-DD). If omitted, defaults to yesterday.
# TARGET_DATE=2026-11-07
